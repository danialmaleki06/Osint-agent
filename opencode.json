{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "osint-mcp": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "osint_mcp.server"],
      "environment": {
        "PYTHONUTF8": "1",
        "OSINT_DEBUG": "false",
        "OSINT_HUMAN_MODE": "true"
      },
      "enabled": true
    }
  }
}
