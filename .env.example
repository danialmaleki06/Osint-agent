# Шаблон для команды: скопировать в .env и подставить свои ключи.
# Сам .env в репозиторий не коммитится.

# Бесплатный тариф, 100 запросов в сутки
DADATA_API_KEY=

# Секретный ключ DaData — нужен только для метода рыночного наименования.
# Метод тарифицируется отдельно от подписки.
DADATA_SECRET_KEY=

CHECKO_API_KEY=

# ── Сетевой режим (нужен, только если сервер выставляется наружу) ──
# Без токена сервер в сеть не выходит: за ним лежат ключи к платным
# справочникам, и открытый адрес позволит любому расходовать квоту.
# OSINT_MCP_TRANSPORT=http
# OSINT_MCP_TOKEN=длинная-случайная-строка
#
# Встроенная защита от подмены адреса принимает только localhost.
# За обратным туннелем или балансировщиком домен надо назвать явно,
# иначе сервер отвечает 421.
# OSINT_MCP_ALLOWED_HOSTS=example.com,127.0.0.1:8000
