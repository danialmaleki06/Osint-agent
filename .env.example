# ==============================================================================
# Шаблон конфигурации окружения для OSINT-Agent (MCP Server)
# Скопируйте этот файл в .env и подставьте ваши реальные API-ключи:
#   cp .env.example .env
#
# Сам файл .env находится в .gitignore и ни при каких условиях не коммитится в Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DaData (Реестры ЕГРЮЛ, адреса, реквизиты, аффилированность)
# Регистрация: https://dadata.ru/
# Бесплатный тариф: 10 000 подсказок в день.
# ------------------------------------------------------------------------------
# Одиночный API-ключ:
DADATA_API_KEY=

# Пул ключей через запятую (при исчерпании суточного лимита одного ключа
# система автоматически и бесшовно переключается на следующий):
DADATA_API_KEYS=

# Секретный ключ DaData (X-Secret):
# Необходим для метода определения бренда/рыночного наименования (/findById/brand)
# и просмотра остатка суточной квоты. Метод тарифицируется отдельно.
DADATA_SECRET_KEY=


# ------------------------------------------------------------------------------
# 2. Checko (Суды, арбитраж Kad.Arbitr, исполнительные производства ФССП, проверки)
# Регистрация: https://checko.ru/
# ------------------------------------------------------------------------------
# Одиночный API-ключ:
CHECKO_API_KEY=

# Пул ключей через запятую (при 401/403/429 переключается на следующий ключ):
CHECKO_API_KEYS=


# ------------------------------------------------------------------------------
# 3. HeadHunter API (Кадровый аудит, наём, стек технологий, смена топ-менеджмента)
# Регистрация приложения: https://dev.hh.ru/
# ------------------------------------------------------------------------------
# Бесплатный токен приложения (App Token). Без токена открытое API вакансий
# возвращает ошибку 403. Если токен пуст — источник помечается как недоступный.
HH_APP_TOKEN=


# ------------------------------------------------------------------------------
# 4. Резервный эшелон: API-Cloud (api-cloud.ru)
# ------------------------------------------------------------------------------
# Персональный ключ агрегатора api-cloud.ru.
# Задействуется ТОЛЬКО как резервный канал, если прямые реестры ФССП или судов недоступны.
APICLOUD_KEY=


# ------------------------------------------------------------------------------
# 5. Поведение аналитического движка и скоринга
# ------------------------------------------------------------------------------
# Режим технической отладки для разработчика (true/false).
# Если false — отдаются только чистые бизнес-факты без мусора о сетевых таймаутах.
OSINT_DEBUG=false

# Человеческий понятный язык отчётов (true/false, по умолчанию true).
# Формирует TL;DR-резюме в 3 предложениях, ответы на 3 ключевых вопроса бизнеса
# и расшифровывает реестровые аббревиатуры (ОКВЭД, ССЧ, ГИР БО, ФССП, РНП).
OSINT_HUMAN_MODE=true

# Экспортировать ли низкоуровневые гранулярные инструменты в реестр MCP (по умолчанию false).
# По умолчанию ядро использует единый инструмент `generate_full_dossier`.
OSINT_EXPOSE_GRANULAR_TOOLS=false


# ------------------------------------------------------------------------------
# 6. Таймауты, кэширование и лимиты обхода графа связей
# ------------------------------------------------------------------------------
# Базовый HTTP-таймаут запросов к внешним API (в секундах):
REQUEST_TIMEOUT=8.0

# Срок жизни локального кэша реестровых ответов (в часах):
CACHE_TTL_HOURS=24

# Максимум страниц для списочных методов Checko и Федресурса:
MAX_PAGES=3

# Лимиты обхода корпоративных связей (предотвращают лавинообразный расход квот):
AFFILIATION_MAX_PEOPLE=10
AFFILIATION_MAX_RELATED=30
AFFILIATION_MAX_DEEP=5


# ------------------------------------------------------------------------------
# 7. Сетевой режим MCP-сервера (Remote / Streamable HTTP)
# Используется, если сервер поднимается не через stdio, а как сетевой сервис.
# ------------------------------------------------------------------------------
# Транспорт сервера: stdio (по умолчанию для десктопных клиентов) или http
OSINT_MCP_TRANSPORT=stdio

# Токен аутентификации (Bearer) для сетевого режима.
# В сетевом режиме ОБЯЗАТЕЛЕН для защиты сервера от несанкционированного расхода квот!
OSINT_MCP_TOKEN=

# Адрес и порт сетевого сервера:
OSINT_MCP_HOST=127.0.0.1
OSINT_MCP_PORT=8000

# Разрешенные внешние хосты через запятую (защита от подмены Host-заголовка):
OSINT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Необязательно. Отдельный HTTP CONNECT-прокси для ФНС, Федресурса,
# Росаккредитации, реестра ПО Минцифры и API подсказок DaData.
# Маршрут прокси нужно настроить отдельно. Пустое значение использует обычный маршрут.
# OSINT_REGISTRY_PROXY_URL=http://127.0.0.1:17891
# IPv4 локального интерфейса для прямого доступа. Адреса разрешаются через
# Google Public DNS по HTTPS. WHOIS также использует указанный интерфейс.
# Если заданы обе настройки, HTTPS-запросы используют прокси.
# OSINT_REGISTRY_BIND_IPV4=192.168.1.10

# Платный резерв: Yandex Search API после отказа бесплатного поиска.
# Нужны сервисный API-ключ с yc.search-api.execute и каталог Yandex Cloud.
# При ошибке выбранного API поиск вернёт unavailable.
# YANDEX_SEARCH_API_KEY=
# YANDEX_SEARCH_FOLDER_ID=
# fallback — бесплатные DuckDuckGo/Yahoo, затем Яндекс только при отказе обоих.
# Корректная пустая выдача не запускает платный резерв.
# disabled — запретить любые обращения к Яндексу; primary — явно выбрать его первым.
YANDEX_SEARCH_MODE=fallback
# Общий бюджет Яндекса на одно досье, включая HTTP-повторы; разрешено 0..4 ₽.
# Каждая попытка заранее резервирует 0,488 ₽. Кеш и бесплатный поиск бюджет не расходуют.
YANDEX_SEARCH_BUDGET_RUB=4


# ------------------------------------------------------------------------------
# 8. Вспомогательные LLM API (для автономных агентов / Goose CLI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=
FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=
